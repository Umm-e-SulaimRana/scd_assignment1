# nginx:alpine substitutes ${VARS} in /etc/nginx/templates/*.template at
# container start (its own 20-envsubst-on-templates.sh entrypoint script), so
# BACKEND_ORIGIN is a runtime value. One image, any environment.
#
# Compose sets it to http://backend:8000; the Kubernetes ConfigMap sets it to
# http://backend.civicpulse.svc.cluster.local:8000. Nothing is baked in, and
# "localhost" appears nowhere -- in a container that would mean the nginx
# container itself, which is the -8 deduction in §5.3.

server {
    listen       8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Written at start-up by 10-config-js.sh. Never cached: it is the one file
    # that differs between environments, and a stale copy would point the app
    # at the wrong API.
    location = /config.js {
        add_header Cache-Control "no-store" always;
        try_files /config.js =404;
    }

    # The frontend calls /api/... on its own origin and nginx forwards it.
    # Consequences worth knowing for the viva: the browser makes a same-origin
    # request, so there is no CORS preflight at all, and the frontend never
    # needs to know a backend hostname.
    location /api/ {
        proxy_pass         ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        # The backend's rate limiter keys on client IP. Without this header it
        # would see the nginx pod's IP and limit every citizen as one caller.
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Request-ID      $request_id;
        # A triage call has a 10s server-side cap; allow for it plus the retry.
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    # Hashed build assets are immutable by construction.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Liveness/readiness target for the frontend pod. Static, no dependencies.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 'ok';
    }

    # SPA fallback: unknown paths are client-side routes, not 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
