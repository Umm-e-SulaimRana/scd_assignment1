# Copy this to .env and fill in real values. .env itself is gitignored --
# never commit real secrets (see rubric §5.3, -20 marks).

DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0

TRIAGE_PROVIDER=simulated   # simulated | rules | llm | ollama

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

RATE_LIMIT_PER_MINUTE=20
STATS_CACHE_TTL=30
TRIAGE_CACHE_TTL=86400

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
